 ],
 "contamination_rule": "A clone that received any manually copied repository/source/data file is CONTAMINATED_DISCARDED and can never become canonical evidence. Never clean and reuse it.",
 "environment": {
  "PYTHONPATH": "src:. (set by the harness for in-clone commands only; none inherited)",
  "browser": "real headless Google Chrome via CDP (same automation class as CAP-010)",
  "home": "isolated temporary HOME",
  "node": "system Node/npm; fresh npm cache in the isolated HOME",
  "python": "newly created Python 3.11 venv at <clone>/.venv (git-ignored) created by the run; never the development .venv",
  "tmpdir": "isolated TMPDIR outside the clone"
 },
 "evidence_files_per_clone": [
  "environment",
  "install",
  "tests",
  "frontend",
  "demo",
  "git_audit"
 ],
 "failed_attempt_rule": "every failed canonical attempt is preserved as attempt_N_FAIL_*.json with target SHA, stage, failure code, contamination flag and discarded flag",
 "no_rescue_rule": "On any failure the harness stops; it has no copy-in or rescue-install path. A release-layer defect requires a new RELEASE_TARGET_SHA and a completely new clone.",
 "only_source_of_repository_bytes": "the remote Git repository at the exact RELEASE_TARGET_SHA (full 40-hex SHA; branch-name-only acceptance is forbidden)",
 "owner_task": "CAP-011",
 "pre_install_audit": "git status --porcelain and --ignored must be empty immediately after checkout; no .venv, node_modules, build output, .env, SQLite, candidate or raw-data path may exist",
 "prohibited": [
  "cp from the original checkout",
  "rsync from the original checkout",
  "manual file copying",
  "copying .venv",
  "copying node_modules",
  "copying frontend build output",
  "copying SQLite files",
  "copying candidate artifacts",
  "copying raw datasets",
  "copying hidden config (.env)",
  "copying generated evidence needed to make tests pass",
  "rescue-installing a missing dependency"
 ],
 "protocol_id": "CAPSTONE_CLEAN_CLONE_PROTOCOL_V1",
 "result_import": "a clone result JSON may be copied back as evidence only after verify_clone_result confirms release_target_sha == RELEASE_TARGET_SHA; inputs are never copied in",
 "status": "FROZEN_PRE_RELEASE_PROTOCOL"
}
