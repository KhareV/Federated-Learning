 },
 "session_runtime_identity": "product.session.default_runtime_identity() (MODEL_V2_FINAL, CAL_V2, PREPROC_V1, ALERT_POLICY_V1, ALERT_POLICY_V1_MODEL_V2_BINDING, GATEWAY_ARTIFACT_V2, API_SCHEMA_V1, SOFTWARE_SYSTEM_V2); never overridable",
 "waveform_policy": {
  "chunk_samples": 60,
  "updates_per_second": 6,
  "rate_hz": 360,
  "unit": "ADC_COUNTS",
  "channel": "ECG",
  "per_sample_messages": false,
  "ppg_waveform": false
 },
 "waveform_gap_policy": {
  "ui_missing_sample": "None (waveform.chunk only); never 0/hold/interpolation",
  "none_reaches_scientific_runtime": false,
  "gap_fill_trigger": "record index jump or a source event with a source timestamp (outage chunks precede the reconnect device.status)"
 },
 "dual_stream_policy": {
  "module": "product/monitoring/mux.py",
  "interface": "frozen public DeviceSource only (no private fields)",
  "order_rule": "event.source_timestamp_us <= record.timestamp_us precedes that record",
  "accelerated": "blocking lookahead: order is a pure function of the source timeline under ANY scheduling",
  "live_speed": "bounded settle (8 loop turns); a slower event view yields a loud MuxOrderError (session FAILED), never a silently different order",
  "limitation": "the frozen DeviceSource interface offers no watermark/heartbeat; a future DeviceSource contract version should add one",
  "stop_semantics": "manual stop stops consuming at the next record; run-ahead source events the product never reached are discarded (counted); a source mid-outage is left in its own link state for the owner to disconnect"
 },
 "inference_boundary": {
  "client": "product/inference/client.py",
  "transport": "localhost HTTP POST /v1/infer-window (API_SCHEMA_V1)",
  "imports": "api.schemas only (typed contract)",
  "direct_model_import": false,
  "retry": "none in CAP-003 (needs separately governed policy)",
  "identity_check": "every 200 asserts MODEL_V2_FINAL / CAL_V2 / PREPROC_V1 / ALERT_POLICY_V1"
 },
 "response_semantics": {
  "200": "quality.status, context.snapshot (response context), inference.result, monitoring.state on first/change",
  "422_unusable": "quality.status only; telemetry EXPECTED_UNUSABLE_WINDOW; NO inference.result / monitoring.state / probability",
  "400": "integration defect -> system.error origin INFERENCE + session FAILED",
  "5xx_or_network": "system.error origin INFERENCE + session FAILED",
  "context_snapshot_clarification": "when the released response has context_available=false but PPG-derived values present, those three values are withheld (frozen validator forbids the combination); counted in telemetry; context_available is never altered"
 },
 "events": {
  "sequencer": "one centralised counter across all monitoring event kinds",
  "event_id": "<session_id>-PEV<sequence:06d>",
  "clock": "injectable; LogicalClock (deterministic) for canonical runs",
  "monitoring_state_policy": "first observation, then on change only"
 },
 "session_lifecycle": {
  "start": "DEVICE_READY -> MONITORING (REST); owner; device CONNECTED; second start -> 409",
  "natural_completion": "MONITORING -> STOPPING -> COMPLETED",
  "manual_stop": "MONITORING -> STOPPING -> COMPLETED (reason USER_STOP)",
  "recoverable_disconnect": "session stays MONITORING",
  "failure": "inference failure / unrecoverable device error / internal error -> FAILED with system.error"
 },
 "websocket": {
  "direction": "server -> client monitoring events only",
  "reconnect_policy": "on connect replay the in-memory journal from sequence 0, then tail",
  "client_frames": "rejected (close 1008); never control monitoring",
  "query_parameters": "ignored; cannot select a model"
 },
 "reproducibility": {
