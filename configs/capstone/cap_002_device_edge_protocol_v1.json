 "device_semantics": {
  "states_and_transitions": "exactly contracts/capstone/device_source_v1.json; illegal transition => IllegalTransitionError, state and event log unchanged",
  "attach_flow": "scan(): SCAN_STARTED->SCANNING, DEVICE_DISCOVERED->FOUND; connect(): PAIRING_STARTED->PAIRING, DEVICE_CONNECTED->CONNECTED; start_stream(): STREAM_STARTED->STREAMING",
  "link_outage": "DEVICE_DISCONNECTED->DISCONNECTED, RECONNECT_STARTED->RECONNECTING at outage start; DEVICE_RECONNECTED->CONNECTED, STREAM_STARTED->STREAMING at outage end. NO record is delivered, buffered or fabricated during the outage.",
  "post_reconnect_clock": "the source clock keeps running during an outage: sample_index and timestamp_us continue from the generator timeline and skip the outage; nothing is replayed",
  "end_of_scenario": "STREAM_STOPPED (reason SCENARIO_COMPLETE) -> STOPPED",
  "user_stop": "stop_stream(): STREAMING->STOPPED (STREAM_STOPPED, reason USER_STOP); STOPPED->CONNECTED via connect() (link kept) or STOPPED->DETACHED via disconnect(); STOPPED->STREAMING is illegal; a restarted stream is a fresh deterministic stream of the same scenario",
  "user_disconnect_while_streaming": "STREAMING->DISCONNECTED->DETACHED (two events)",
  "device_error": "simulate_error() raises DEVICE_ERROR only where the frozen lifecycle allows ->ERROR",
  "events": "typed DeviceEvent (DEVICE_EVENT_V1); sequence_index 0..n contiguous; event_id '<device_id>-EV<seq:06d>'; state must equal the frozen event->state effect; session_id None until start_stream; no physiological/model fields",
  "timestamp_semantics": "source_timestamp_us = ObservedRecord timeline microseconds (None for attach events); product_timestamp_us = deterministic LOGICAL product clock (pre-stream: sequence*1000 us; in-stream: 1_000_000 + source_timestamp_us); no wall clock enters any event",
  "descriptor": "adapter_type SIMULATED; dataset WEARABLE_SIM_V1; source_mode SYNTHETIC_PHYSIOLOGY; simulation true; capability nominal rate key ECG_SIMULATION_CONVENTION=360 (simulation convention, not hardware evidence); supports_ppg=false (no PPG waveform is emitted), supports_spo2_context=true; hardware_specific_fields_status NOT_APPLICABLE",
  "not_claimed": [
