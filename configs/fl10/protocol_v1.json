 "metrics": {
  "definitions": {
   "AUPRC": {
    "definition": "average precision = sum_n (R_n - R_{n-1}) P_n (sklearn average_precision_score, non-interpolated)",
    "undefined_when": "needs both classes"
   },
   "AUROC": {
    "definition": "area under the ROC curve (sklearn roc_auc_score)",
    "undefined_when": "needs both classes"
   },
   "BCE": {
    "definition": "mean unweighted binary cross-entropy from raw logits",
    "undefined_when": "never undefined"
   },
   "Brier": {
    "definition": "mean (sigmoid(logit) - label)^2",
    "undefined_when": "never undefined"
   },
   "F1": {
    "definition": "2TP / (2TP + FP + FN), positive class",
    "undefined_when": "2TP+FP+FN = 0"
   },
   "MCC": {
    "definition": "(TP*TN - FP*FN) / sqrt((TP+FP)(TP+FN)(TN+FP)(TN+FN))",
    "undefined_when": "any marginal total is zero"
   },
   "accuracy": {
    "definition": "(TP+TN) / N",
    "undefined_when": "never undefined for N > 0"
   },
   "balanced_accuracy": {
    "definition": "(recall + specificity) / 2",
    "undefined_when": "recall or specificity undefined"
   },
   "false_discovery_rate": {
    "definition": "FP / (FP+TP) = 1 - precision",
    "undefined_when": "no predicted positives"
   },
   "false_negative_rate": {
    "definition": "FN / (FN+TP)",
    "undefined_when": "no actual positives"
   },
   "false_omission_rate": {
    "definition": "FN / (FN+TN) = 1 - NPV",
    "undefined_when": "no predicted negatives"
   },
   "false_positive_rate": {
    "definition": "FP / (FP+TN)",
    "undefined_when": "no actual negatives"
   },
   "negative_predictive_value": {
    "definition": "TN / (TN+FN)",
    "undefined_when": "no predicted negatives"
   },
   "participant_macro_F1": {
    "definition": "mean of per-participant F1 over participants where F1 is defined; the contributing count is reported",
    "undefined_when": "no participant has defined F1"
   },
   "precision": {
    "definition": "TP / (TP+FP) = PPV",
    "undefined_when": "no predicted positives"
   },
   "recall": {
    "definition": "TP / (TP+FN) = sensitivity = TPR",
    "undefined_when": "no actual positives"
   },
   "specificity": {
    "definition": "TN / (TN+FP) = TNR",
    "undefined_when": "no actual negatives"
   }
  },
