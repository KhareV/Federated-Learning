# Preserve local datasets, but never commit downloaded payloads. Dataset
# manifests, split definitions, licenses, and checksum records remain trackable.
data/raw/**
!data/raw/**/
!data/raw/**/LICENSE*
!data/raw/**/README*
!data/raw/**/SHA256SUMS.txt
data/downloads/
datasets/downloads/
