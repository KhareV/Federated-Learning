{
 "contract_id": "PRODUCT_LIVE_EVENT_V1",
 "contract_version": "PRODUCT_LIVE_EVENT_V1",
 "status": "FROZEN_INTERFACE_CONTRACT",
 "python_authority": "product/events.py",
 "json_schema": "contracts/capstone/live_event_v1.schema.json",
 "schema_generation": "scripts/cap_001_generate_contracts.py (parity with product/events.py is tested)",
 "discriminator": "event_type",
 "event_kinds": [
  "device.status",
  "session.status",
  "waveform.chunk",
  "context.snapshot",
  "quality.status",
  "inference.result",
  "monitoring.state",
  "system.error",
  "federation.status",
  "round.status",
  "client.status",
  "client.training_progress",
  "client.update_ready",
  "aggregation.status",
  "secagg.status",
  "candidate.created",
  "candidate.validation",
  "candidate.governance",
  "federation.completed",
  "federation.error"
 ],
 "required_envelope_fields": [
  "contract_version",
  "event_id",
  "event_type",
  "sequence_index",
  "emitted_at_us",
  "payload"
 ],
 "optional_envelope_fields": [
  "source_timestamp_us (monitoring only)"
 ],
 "timestamp_semantics": {
  "sequence_index": "strictly increasing, contiguous per session (monitoring) or per run (federation) across ALL event kinds of that stream; the only ordering key",
  "event_id": "unique per event within its stream",
  "source_timestamp_us": "monitoring only: microseconds on the source/ObservedRecord timeline",
  "emitted_at_us": "product-clock time of emission; never used for ordering"
 },
 "untyped_payload_allowed": false,
 "waveform_transport_policy": {
  "scientific_source_rate_hz": 360,
  "ui_updates_per_second": {
   "min": 5,
   "max": 10
  },
  "nominal_samples_per_chunk": {
   "min": 36,
   "max": 72
  },
  "hard_max_samples_per_chunk": 144,
  "per_sample_websocket_messages_allowed": false,
  "chunks_contiguous": "next first_sample_index == previous first_sample_index + sample_count (enforced by the CAP-003 coordinator)",
  "unit": "ADC_COUNTS",
  "channels": [
   "ECG",
   "PPG_RED",
   "PPG_IR"
  ],
  "independence": "Waveform UI transport is independent of the scientific 360->250 Hz PREPROC_V1 model path, which is unchanged."
 },
 "context_policy": {
  "fields": [
   "hr_ecg_bpm",
   "pr_ppg_bpm",
   "spo2_pct",
   "spo2_valid",
   "context_available",
   "ppg_quality"
  ],
  "frontend_may_fabricate": false,
  "unavailable_is_explicit": true
 },
 "quality_mapping": {
  "VALID": "Signal Good",
  "DEGRADED": "Signal Degraded",
  "UNUSABLE": "Recheck Sensor",
  "canonical_value_always_present": true,
  "new_quality_algorithm": false
 },
 "monitoring_state_vocabulary": [
  "NORMAL_MONITORED_PATTERN",
  "POTENTIAL_ECTOPY_ASSOCIATED_PATTERN",
  "RECHECK_SENSOR",
  "CONTEXT_UNAVAILABLE",
  "SYSTEM_ERROR"
 ],
 "monitoring_state_ui_labels": {
  "NORMAL_MONITORED_PATTERN": "Normal monitored pattern",
  "POTENTIAL_ECTOPY_ASSOCIATED_PATTERN": "Potential ectopy-associated pattern",
  "RECHECK_SENSOR": "Recheck sensor",
  "CONTEXT_UNAVAILABLE": "Context unavailable",
  "SYSTEM_ERROR": "System error"
 },
 "forbidden_states": [
  "ARRHYTHMIA_DETECTED",
  "DISEASE",
  "AFIB",
  "NORMAL_PATIENT"
 ],
 "inference_event_source": "Derived exclusively from a real POST /v1/infer-window InferWindowResponse; probability fields are research/technical metadata, never the primary user-facing medical interpretation.",
 "inference_event_fields": [
  "timestamp_us",
  "model_id",
  "calibration_id",
  "calibration_domain",
  "preprocess_version",
  "alert_policy_id",
  "ecg_quality",
  "monitoring_state",
  "context",
  "latency_ms",
  "raw_probability",
  "source_domain_calibrated_probability",
  "threshold",
  "probability_role"
 ],
 "websocket_close_codes": {
  "4401": "unauthenticated",
  "4403": "not session owner",
  "4404": "unknown session"
 },
 "monitoring_event_kinds": [
  "device.status",
  "session.status",
  "waveform.chunk",
  "context.snapshot",
  "quality.status",
  "inference.result",
  "monitoring.state",
  "system.error"
 ],
 "federation_event_kinds": [
  "federation.status",
  "round.status",
  "client.status",
  "client.training_progress",
  "client.update_ready",
  "aggregation.status",
  "secagg.status",
  "candidate.created",
  "candidate.validation",
  "candidate.governance",
  "federation.completed",
  "federation.error"
 ],
 "identity_fields": {
  "monitoring": "session_id (required)",
  "federation": "run_id (required)"
 },
 "stream_separation": {
  "monitoring_ws_accepts_only": "monitoring event kinds",
  "federation_ws_accepts_only": "federation event kinds"
 },
 "federation_invariants": {
  "production_deployed_field_always_false": true,
  "secagg_claim_scope": "PROTECTED_AGGREGATION_INTERFACE_ONLY",
  "engineering_only": true
 }
}
