  "base": "SystemInfo of CAPSTONE_PRODUCT_API_V1 (every V1 field retained with the same name and meaning)",
  "added_fields": {
   "product_api_implementation": "CAPSTONE_PRODUCT_API_V1_1",
   "auth_provider": "CLERK | DEMO",
   "demo_mode": "boolean; true only for the explicit offline faculty DemoAuth identity"
  },
  "changed_values": {
   "persistence_mode": "SQLITE (was EPHEMERAL_CAP003)",
   "auth_status": "CONFIGURED (was INJECTED | NOT_CONFIGURED)",
   "product_api_version": "PRODUCT_API_V2"
  },
  "forbidden": "no scientific, model, calibration or threshold selector may appear in SystemInfo"
 },
 "me_response": "AuthIdentity (user_id, display_name, email, auth_provider, auth_session_id, roles, demo_mode); no scientific/runtime field is derived from identity",
 "session_create_request": {
  "fields": [
   "device_id",
   "scenario_id"
  ],
  "extra_fields": "forbidden (HTTP 400)",
  "rules": [
   "authenticated owner",
   "device owned by caller and CONNECTED",
   "scenario_id must equal the persisted device scenario (else 400 INVALID_REQUEST)",
   "runtime identity fixed to the frozen default",
   "creates CREATED -> DEVICE_READY; never starts monitoring"
  ]
 },
 "session_list_semantics": {
  "scope": "caller-owned only",
  "order": "created_at_us descending, then session_id descending (stable)",
  "cross_user": "other users' sessions are never listed"
 },
