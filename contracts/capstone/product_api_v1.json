{
 "contract_id": "PRODUCT_API_CONTRACT_V1",
 "contract_version": "PRODUCT_API_V1",
 "status": "FROZEN_INTERFACE_CONTRACT",
 "base_path": "/product/v1",
 "framework": "FastAPI (separate product app; NOT the frozen inference app)",
 "frozen_inference_api": {
  "contract": "API_SCHEMA_V1",
  "route": "POST /v1/infer-window",
  "modified_by_product": false,
  "product_may_add_routes_to_frozen_api": false,
  "api_schema_v2_created": false
 },
 "inference_boundary": {
  "design": "product inference client -> localhost/internal HTTP -> DEFAULT V2 inference service -> POST /v1/infer-window",
  "reason": "Exercises the same released API boundary that the existing frontend and replay evidence already validated.",
  "direct_model_import_allowed": false,
  "second_inference_implementation_allowed": false,
  "client_owner_phase": "CAP-003",
  "internal_only": true
 },
 "route_change_policy": "Any route change after CAPG0 requires an additive contract successor (PRODUCT_API_CONTRACT_V2); silent drift is forbidden.",
 "auth_values": {
  "PUBLIC": "no identity required",
  "AUTHENTICATED": "AuthProvider identity required (Clerk or explicit demo)"
 },
 "ownership_scopes": {
  "NONE": "no owned resource",
  "SELF": "caller's own identity",
  "OWN": "only resources owned by the caller",
  "GLOBAL_READ": "any authenticated identity may read; no write"
 },
 "forbidden_request_field_names": [
  "alert_policy",
  "alert_policy_id",
  "base_model_id",
  "calibration",
  "calibration_id",
  "candidate_id",
  "checkpoint",
  "checkpoint_id",
  "gateway_artifact_id",
  "learning_rate",
  "model",
  "model_id",
  "mu",
  "optimizer",
  "preprocess_id",
  "threshold"
 ],
 "routes": [
  {
   "route_id": "system.get",
   "method": "GET",
   "path": "/product/v1/system",
   "owner_phase": "CAP-003",
   "auth": "PUBLIC",
   "ownership_scope": "NONE",
   "request_fields": [],
   "response_contract": "SystemInfo",
   "notes": "Read-only: auth mode (demo banner flag), frozen runtime identity, hardware status (simulated only). Never accepts a model selector."
  },
  {
