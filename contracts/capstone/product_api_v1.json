 "frontend_routes": {
  "status": "ROUTE_CONTRACT_ONLY (CAP-001 implements no pages and does not modify frontend/)",
  "foundation": "existing frontend/ SvelteKit app (mandatory; the only frontend). Planned additive successor identity: CAPSTONE_UI_V1. No new scaffold, no framework migration, no duplicated components.",
  "successor_identity": "CAPSTONE_UI_V1",
  "existing_routes_preserved": true,
  "routes": [
   "/",
   "/sign-in",
   "/app",
   "/app/device",
   "/app/monitoring",
   "/app/history",
   "/app/history/[session_id]",
   "/app/federation",
   "/app/federation/clients",
   "/app/federation/rounds",
   "/app/federation/live",
   "/app/federation/privacy",
   "/app/models",
   "/app/research/ml",
   "/app/research/fl",
   "/app/system",
   "/app/about"
  ],
  "federation_first_class": "Federation is a top-level section of /app, not only a Research sub-page.",
  "reuse": {
   "/app/monitoring": "frontend/src/routes/monitoring + frontend/src/lib/dashboard + components/dashboard (verified V2 dashboard path, DASHBOARD_UI_V1_5)",
   "/app/device": "frontend/src/lib/components/hardware",
   "/app/federation/*": "frontend/src/lib/components/federation + existing /fl/* routes and stores/fl.svelte.ts",
   "/app/research/ml": "existing /research/* and /ai/* route components",
   "/app/research/fl": "existing /fl/* routes",
   "/app/system": "existing /system/health"
  }
 },
 "forbidden_route_fragments": [
  "promote",
  "deploy",
  "select_model",
  "set_default_model",
  "switch_model"
 ]
}
