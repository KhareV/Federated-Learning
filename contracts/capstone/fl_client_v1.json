   "FAILED"
  ],
  "TRAINING": [
   "UPDATE_READY",
   "FAILED"
  ],
  "UPDATE_READY": [
   "SUBMITTED",
   "FAILED"
  ],
  "SUBMITTED": [
   "IDLE",
   "REJECTED"
  ],
  "REJECTED": [
   "IDLE"
  ],
  "FAILED": [
   "IDLE"
  ]
 },
 "update_submission_fields": [
  "client_id",
  "round_id",
  "base_state_digest",
  "update_digest",
  "examples_seen"
 ],
 "update_envelope_reuse": "federated/wearable_fl_system_v1.py ENVELOPE_FIELDS / make_envelope (V2_FL_WEARABLE_SYSTEM_PROTOCOL_V1); the product UpdateSubmission is the server-visible metadata projection of that envelope under update_submission_envelope_mapping (product names -> existing envelope field names)",
 "existing_modules_reused": {
  "client_dataset_and_windows": "federated/virtual_client_source_v1.py",
