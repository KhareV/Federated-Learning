  "fedprox_objective": "federated/model_v2_fedprox.py",
  "weighted_delta_aggregation": "federated/aggregation.py::aggregate_weighted_deltas",
  "coordinator_and_round_logic": "federated/wearable_fl_system_v1.py::Coordinator",
  "round_runner": "federated/wearable_fl_runner_v1.py::execute_round / run_full / run_part1 / run_part2",
  "secagg": "privacy/secagg_app.py (Flower SecAgg+), federated/wearable_fl_secagg_shadow_v1.py"
 },
 "new_fl_implementation_allowed": false,
