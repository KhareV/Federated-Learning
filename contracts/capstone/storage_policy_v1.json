    "source_dataset_id": "TEXT?",
    "source_mode": "TEXT?",
    "simulation_version": "TEXT?",
    "capabilities_json": "TEXT",
    "created_at_us": "INTEGER"
   },
   "foreign_keys": [
    {
     "column": "user_id",
     "references": "users.user_id"
    }
   ],
   "ownership": "user_id",
   "indexes": [
    {
     "name": "ix_devices_user",
     "columns": [
      "user_id"
     ],
     "unique": false
    }
   ],
   "retention_intent": "kept while the owner exists",
   "max_write_rate": "",
   "notes": ""
  },
  {
   "entity": "device_connections",
   "table": "device_connections",
   "primary_key": "connection_id",
   "columns": {
    "connection_id": "TEXT",
    "device_id": "TEXT",
    "session_id": "TEXT?",
    "event_type": "TEXT",
    "device_state": "TEXT",
    "sequence_index": "INTEGER",
    "reason_code": "TEXT?",
    "recoverable": "INTEGER",
    "at_us": "INTEGER"
   },
   "foreign_keys": [
    {
     "column": "device_id",
     "references": "devices.device_id"
    },
    {
