{
 "contract_id": "CAPSTONE_STORAGE_POLICY_V1",
 "contract_version": "CAPSTONE_STORAGE_V1",
 "status": "FROZEN_PRODUCT_POLICY",
 "engine": "SQLITE",
 "mode": "capstone/local (not hospital infrastructure)",
 "database_server_required": false,
 "default_path": "data/capstone/product.sqlite3",
 "pragmas": {
  "foreign_keys": "ON",
  "journal_mode": "WAL"
 },
 "implemented_now": false,
 "implementation_phase": "CAP-004 (migrations/runtime); CAP-001 only validates the schema contract in tests",
 "high_rate_policy": {
  "per_sample_rows_allowed": false,
  "raw_360hz_sample_table_allowed": false,
  "forbidden_entity_name_fragments": [
   "sample",
   "raw_ecg",
   "raw_ppg",
   "ecg_raw"
  ],
  "forbidden_column_names": [
   "ecg_raw",
   "ppg_red_raw",
   "ppg_ir_raw",
   "sample_index_value"
  ],
  "stream_policy": "360 Hz source data is streamed, not stored relationally. Relational rows are bounded: inference <= 1/window, context <= 1/s, state & quality on change only, waveform preview <= max_preview_points per channel.",
  "max_preview_points_per_channel": 4000
 },
 "raw_session_artifact_policy": {
  "mandatory": false,
  "simulated_sessions": "Prefer deterministic regeneration from (scenario_id, seed, simulation_version); no raw persistence required.",
  "engineering_replay_artifact": "If ever persisted, an explicit versioned session artifact file (not SQL rows) with its own schema_version and sha256 recorded on the session row."
 },
 "entities": [
  {
   "entity": "users",
   "table": "users",
   "primary_key": "user_id",
   "columns": {
    "user_id": "TEXT",
    "auth_provider": "TEXT",
    "display_name": "TEXT?",
    "email": "TEXT?",
    "demo_mode": "INTEGER",
    "created_at_us": "INTEGER"
   },
   "foreign_keys": [],
   "ownership": "SELF",
   "indexes": [],
   "retention_intent": "kept until the user is deleted",
   "max_write_rate": "",
   "notes": "Mirror of the AuthProvider identity; no credentials stored."
  },
  {
   "entity": "devices",
   "table": "devices",
   "primary_key": "device_id",
   "columns": {
    "device_id": "TEXT",
    "user_id": "TEXT",
