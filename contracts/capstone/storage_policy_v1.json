  "fl_demo_runs_scientific_evidence": false,
  "candidate_weights_in_sql_rows": false,
  "raw_or_label_or_truth_data_in_federation_tables": false
 },
 "claims": "stored values are research/engineering session records, not clinical records",
 "data_locality": {
  "reference": "contracts/capstone/federation_v1.json::data_locality",
  "federation_tables_hold": "run/round/client-status/candidate/governance metadata only"
 }
