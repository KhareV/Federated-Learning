{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nhm.local/contracts/run_manifest_v1.schema.json",
  "title": "NHM Run Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "run_id",
    "created_at_utc",
    "phase_id",
    "task_id",
    "spec_version",
    "git_commit",
    "git_dirty",
    "python_version",
    "platform",
    "config_path",
    "config_sha256",
    "dependency_snapshot_path",
    "dependency_snapshot_sha256",
    "input_artifacts",
    "output_artifacts",
    "seed",
    "notes"
  ],
  "properties": {
    "manifest_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "phase_id": { "type": "string", "pattern": "^T[0-9]{3}$" },
    "task_id": { "type": "string", "minLength": 1 },
    "spec_version": { "const": "2.2" },
    "git_commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$" },
    "git_dirty": { "type": ["boolean", "null"] },
    "python_version": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "config_path": { "type": ["string", "null"] },
    "config_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "dependency_snapshot_path": { "type": ["string", "null"] },
    "dependency_snapshot_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_artifacts": { "$ref": "#/$defs/artifacts" },
    "output_artifacts": { "$ref": "#/$defs/artifacts" },
    "seed": { "type": ["integer", "null"] },
    "notes": { "type": ["string", "null"] }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    }
  }
}

