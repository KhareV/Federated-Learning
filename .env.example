MONGODB_URI=
MONGODB_DATABASE=
MONGODB_COLLECTION=

# NAMES ONLY - never put real values here. Copy to .env (git-ignored) and fill locally.
# Provider selection has NO default: the product refuses to start unless this is CLERK or DEMO.
NHM_PRODUCT_AUTH_MODE=
# DEMO mode (offline faculty): requires this exact acknowledgement value to start.
NHM_PRODUCT_DEMO_AUTH_ACK=
NHM_PRODUCT_DEMO_USER_ID=
NHM_PRODUCT_DEMO_DISPLAY_NAME=
# CLERK mode (official clerk-backend-api SDK; session tokens only)
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_PUBLISHABLE_KEY=
NHM_CLERK_AUTHORIZED_PARTIES=
# Product runtime
NHM_PRODUCT_DB_PATH=
NHM_PRODUCT_INFERENCE_URL=
NHM_PRODUCT_ALLOWED_ORIGINS=
